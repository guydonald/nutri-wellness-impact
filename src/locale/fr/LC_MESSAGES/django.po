msgid ""
"Note your meals for a few days. Your dietitian uses them to adapt your plan."
msgstr ""
"Notez vos repas pendant quelques jours. Votre nutritionniste s'en sert pour "
"adapter votre plan."

#: patients/espace_patient
msgid "Receive your meal plan"
msgstr "Recevez votre plan de repas"

#: patients/espace_patient
msgid "Your plan is ready: check it every day."
msgstr "Votre plan est prêt : consultez-le chaque jour."

