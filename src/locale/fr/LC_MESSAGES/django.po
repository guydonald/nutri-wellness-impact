msgid "Body measurements"
msgstr "Mesures du corps"

#: patients/espace_patient
msgid "Meals and drinks"
msgstr "Repas et boissons"

#: patients/espace_patient
msgid "Appetite and goals"
msgstr "Appétit et objectifs"

#: patients/espace_patient
msgid "Done - welcome to Nutri-Wellness Impact."
msgstr "C'est fait - bienvenue sur Nutri-Wellness Impact."

#: patients/espace_patient
msgid "Give the essentials"
msgstr "Donnez l'essentiel"

#: patients/espace_patient
msgid "Age, height and weight: the basis of your follow-up."
msgstr "Âge, taille et poids : la base de votre suivi."

#: patients/espace_patient
msgid "Complete my information"
msgstr "Compléter"

