{% load static %}{
  "name": "Nutri-Wellness Impact",
  "short_name": "Nutri-Wellness",
  "description": "Votre suivi nutritionnel : bilan, journal alimentaire et plan de repas.",
  "lang": "fr",
  "id": "/",
  "start_url": "/home/?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#5a8f3d",
  "icons": [
    {"src": "{% static 'pwa/icon-192.png' %}", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "{% static 'pwa/icon-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "{% static 'pwa/maskable-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ]
}
